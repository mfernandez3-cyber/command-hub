# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only. Agent keys, the agent desk, and wake hooks need this.
# Supabase: Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Cursor cloud agents. From your Cursor account API keys.
CURSOR_API_KEY=
# owner/name used when a task does not name a repo
CURSOR_DEFAULT_REPO=
# Branch Cursor starts from. Defaults to main.
CURSOR_DEFAULT_BRANCH=main

# Public address of this Hub. Leave unset on Vercel.
# HUB_URL=https://command-hub-phi.vercel.app
